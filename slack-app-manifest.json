{
  "_metadata": {
    "major_version": 2,
    "minor_version": 1
  },
  "display_information": {
    "name": "Grok Build CLI",
    "description": "Connects Grok Build CLI to Slack as you. Messages post as your user.",
    "background_color": "#1a1a1a"
  },
  "oauth_config": {
    "redirect_urls": [
      "http://127.0.0.1:3118/callback",
      "http://localhost:3118/callback"
    ],
    "pkce_enabled": true,
    "scopes": {
      "user": [
        "search:read.public",
        "search:read.private",
        "search:read.mpim",
        "search:read.im",
        "search:read.files",
        "search:read.users",
        "emoji:read",
        "chat:write",
        "channels:history",
        "groups:history",
        "mpim:history",
        "im:history",
        "channels:read",
        "groups:read",
        "im:read",
        "mpim:read",
        "channels:write",
        "groups:write",
        "im:write",
        "mpim:write",
        "reactions:read",
        "reactions:write",
        "canvases:read",
        "canvases:write",
        "users:read",
        "users:read.email",
        "files:read",
        "files:write",
        "lists:read",
        "lists:write"
      ]
    }
  },
  "settings": {
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": true
  }
}
